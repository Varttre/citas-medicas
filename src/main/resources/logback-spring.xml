<?xml version="1.0" encoding="UTF-8"?>
<!--
  Registro técnico de la aplicación (Logback). Escribe en la consola y en logs/citas.log.
  El archivo cambia cada día y se guardan los últimos 14 días.
  %X{peticion} es el código de la petición que pone FiltroCorrelacion.
-->
<configuration>
    <property name="PATRON" value="%d{yyyy-MM-dd HH:mm:ss} %-5level [%X{peticion}] %logger{36} - %msg%n"/>

    <appender name="CONSOLA" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${PATRON}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="ARCHIVO" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/citas.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/citas.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>14</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${PATRON}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLA"/>
        <appender-ref ref="ARCHIVO"/>
    </root>
</configuration>
